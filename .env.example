# DeepL API Free key — get one at https://www.deepl.com/pro (plan: API Free)
# Keys from the free plan end in :fx
DEEPL_API_KEY=your-key-here:fx

# AI provider key for the Resume by JD feature.
# Provider is auto-detected from the key prefix:
#   AIza...   → Google Gemini Flash (free tier: https://aistudio.google.com/apikey)
#   sk-ant-...→ Anthropic Claude (future)
# Leave unset to disable the /jd feature (the app works fine without it).
AI_PROVIDER_API_KEY=
